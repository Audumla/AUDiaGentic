# Install smoke test: validates that `audiagentic install` produces a working
# agent binary with all nested packages correctly populated.
#
# Build and run:
#   docker build -f Dockerfile.install-test -t audia-install-test .
#   docker run --rm audia-install-test
#
# Expected output: "PASS: agent install OK" on success, non-zero exit on failure.

FROM node:22-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV AUDIAGENTIC_STARTUP_STATUS=0
ENV AUDIAGENTIC_AUTO_UPDATE_ENABLED=false

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv python3-dev \
        git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Build and install the wheel
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-compile --break-system-packages \
        setuptools wheel build \
    && python3 -m build --wheel --no-isolation --outdir /dist

WORKDIR /app
RUN pip install --no-cache-dir --no-compile --break-system-packages /dist/*.whl mcp

# Set up a minimal project root so audiagentic knows where it is
COPY .audiagentic/config ./.audiagentic/config
ENV AUDIAGENTIC_REPO_ROOT=/app

# Run install, then validate the resulting agent binary and dist contents
RUN audiagentic install --target /root/.audiagentic/harness \
    && echo "--- Validating install ---" \
    && test -f /root/.audiagentic/harness/cli/node_modules/.bin/pi \
    && echo "PASS: pi binary exists" \
    && python3 -c "
import sys
from pathlib import Path
pi_pkg = Path('/root/.audiagentic/harness/cli/node_modules/@earendil-works/pi-coding-agent')
nested = pi_pkg / 'node_modules' / '@earendil-works'
if not nested.exists():
    print('SKIP: no nested @earendil-works packages')
    sys.exit(0)
empty = [d.name for d in nested.glob('*') if (d / 'dist').exists() and not any((d / 'dist').iterdir())]
if empty:
    print(f'FAIL: empty dist/ in: {empty}', file=sys.stderr)
    sys.exit(1)
print('PASS: all nested @earendil-works dist/ directories populated')
" \
    && echo "PASS: agent install OK"

CMD ["echo", "Install test image — run with: docker build -f Dockerfile.install-test -t audia-install-test . && docker run --rm audia-install-test"]
