{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiagentic.dev/schemas/recipes/declarative-recipe/v1",
  "title": "Declarative Recipe Definition v1",
  "description": "Config-managed recipe template: strict schema for shared lifecycle steps and probes. Public plan/apply/prune/status fields are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe-id", "recipe-version", "parameters", "lifecycle"],
  "properties": {
    "recipe-id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
    },
    "recipe-version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "provenance-ref": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "replaces-version": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "parameters": {
      "$ref": "#/definitions/ParameterArray"
    },
    "lifecycle": {
      "$ref": "#/definitions/LifecycleDefinition"
    }
  },
  "definitions": {
    "ParameterArray": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": "string"
          },
          "sensitive": {
            "type": "boolean"
          }
        }
      }
    },
    "LifecycleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install-steps"],
      "properties": {
        "probe": {
          "$ref": "#/definitions/ProbeDefinition"
        },
        "install-steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StepDefinition"
          }
        },
        "configure-steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StepDefinition"
          }
        },
        "verify": {
          "$ref": "#/definitions/ProbeDefinition"
        },
        "uninstall-steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StepDefinition"
          }
        },
        "dry-run-steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StepDefinition"
          }
        }
      }
    },
    "ProbeDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "command"],
          "properties": {
            "type": { "const": "command" },
            "command": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
              ]
            },
            "expect-exit": { "type": "integer" },
            "output-pattern": { "type": "string" },
            "timeout": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "file-exists" },
            "path": { "type": "string", "minLength": 1 },
            "content-pattern": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "key-path"],
          "properties": {
            "type": { "const": "config-key" },
            "path": { "type": "string", "minLength": 1 },
            "key-path": {
              "oneOf": [
                { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
                { "type": "string", "minLength": 1 }
              ]
            },
            "expected-value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "checks"],
          "properties": {
            "type": { "const": "composite" },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ProbeDefinition"
              },
              "minItems": 1
            },
            "mode": {
              "enum": ["and", "or", "atleast"]
            },
            "threshold": {
              "type": "integer",
              "minimum": 1
            },
            "retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "delay-seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            }
          }
        }
      ]
    },
    "StepDefinition": {
      "comment": "Step envelope only. Each step's fields are validated by the JSON-schema fragment its `type` registers in foundation.steps.factory (builtins) or a component (e.g. providers). No step-type list is hard-coded here.",
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "PlatformOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "win": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            { "type": "string", "minLength": 1 }
          ]
        },
        "darwin": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            { "type": "string", "minLength": 1 }
          ]
        },
        "linux": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            { "type": "string", "minLength": 1 }
          ]
        }
      }
    }
  }
}
