{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "settings: providers",
  "description": "Provider settings, owned by the providers component: the enabled policy, named instances and the provider's own options (default-model, settings, prompt-surface, ...). install-mode and access-mode come from the provider descriptor. Availability is observed at use time and qualification comes from evidence; neither is configured here.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[a-z0-9][a-z0-9_-]{0,63}$": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "enum": [
            "auto",
            true,
            false
          ],
          "description": "auto (default) enables a provider that is usable here; true and false force it on or off."
        },
        "instances": {
          "type": "object",
          "description": "Named option overlays on this one provider. An agent selects one with `instance`; the provider's own validator checks the options.",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,31}$": {
              "type": "object"
            }
          }
        },
        "base-url": {
          "type": "string"
        },
        "default-model": {
          "type": "string"
        },
        "settings": {
          "type": "object",
          "additionalProperties": true
        },
        "timeout-seconds": {
          "type": "integer",
          "minimum": 1
        },
        "model-aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "catalog-refresh": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "cli",
                "api",
                "static"
              ]
            },
            "max-age-hours": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "auth-ref": {
          "type": "string",
          "pattern": "^env:[A-Z0-9_]+$"
        },
        "prompt-surface": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tag-syntax": {
              "type": "string",
              "enum": [
                "prefix-token-v1"
              ]
            },
            "first-line-policy": {
              "type": "string",
              "enum": [
                "first-non-empty-line"
              ]
            },
            "cli-mode": {
              "type": "string",
              "enum": [
                "native-pass-through",
                "wrapper-normalize",
                "extension-normalize",
                "bridge-wrapper",
                "unsupported"
              ]
            },
            "vscode-mode": {
              "type": "string",
              "enum": [
                "native-pass-through",
                "wrapper-normalize",
                "extension-normalize",
                "bridge-wrapper",
                "unsupported"
              ]
            },
            "settings-profile": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "tag-syntax",
            "first-line-policy",
            "settings-profile"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "anyOf": [
                  {
                    "required": [
                      "cli-mode"
                    ]
                  },
                  {
                    "required": [
                      "vscode-mode"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "execution-policy": {
          "type": "object",
          "properties": {
            "output-format": {
              "type": "string",
              "enum": [
                "text",
                "json",
                "stream-json"
              ]
            },
            "permission-mode": {
              "type": "string",
              "enum": [
                "auto",
                "acceptEdits",
                "bypassPermissions",
                "default",
                "dontAsk",
                "plan"
              ]
            },
            "safety-mode": {
              "type": "string",
              "enum": [
                "standard",
                "relaxed",
                "strict"
              ]
            },
            "auto-approve": {
              "type": "boolean"
            },
            "full-auto": {
              "type": "boolean"
            },
            "ephemeral": {
              "type": "boolean"
            },
            "target-type": {
              "type": "string"
            },
            "timeout-seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
