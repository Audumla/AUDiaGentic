{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "settings: prompt-launch",
  "description": "Defaults for launching a prompt as a job: review policy, stream and input controls, and whether an ad hoc target is allowed. The agent-jobs component owns this section.",
  "x-audiagentic-scopes": [
    "user",
    "user-project",
    "project",
    "explicit"
  ],
  "properties": {
    "allow-adhoc-target": {
      "type": "boolean"
    },
    "default-review-policy": {
      "type": "object",
      "properties": {
        "required-reviews": {
          "type": "integer",
          "minimum": 1
        },
        "aggregation-rule": {
          "type": "string",
          "enum": [
            "all-pass",
            "majority-pass"
          ]
        },
        "require-distinct-reviewers": {
          "type": "boolean"
        }
      },
      "required": [
        "required-reviews",
        "aggregation-rule",
        "require-distinct-reviewers"
      ],
      "additionalProperties": false
    },
    "default-stream-controls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tee-console": {
          "type": "boolean"
        },
        "capture-stdout": {
          "type": "boolean"
        },
        "capture-stderr": {
          "type": "boolean"
        },
        "capture-progress": {
          "type": "boolean"
        },
        "event-format": {
          "type": "string",
          "enum": [
            "ndjson"
          ]
        },
        "timeout-warning-seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "timeout-seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "sink-error-policy": {
          "type": "string",
          "enum": [
            "warn",
            "fail",
            "normalize"
          ]
        },
        "control-validation-policy": {
          "type": "string",
          "enum": [
            "normalize",
            "warn",
            "fail"
          ]
        },
        "termination-policy": {
          "type": "string",
          "enum": [
            "graceful-kill",
            "warn-only"
          ]
        },
        "invalid-event-policy": {
          "type": "string",
          "enum": [
            "quarantine",
            "fail",
            "warn"
          ]
        },
        "event-write-policy": {
          "type": "string",
          "enum": [
            "locked-append",
            "append"
          ]
        },
        "event-schema-validation": {
          "type": "boolean"
        },
        "in-memory-max-bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "large-output-warning-bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "overflow-policy": {
          "type": "string",
          "enum": [
            "warn-only",
            "fail",
            "truncate-head",
            "truncate-tail"
          ]
        },
        "overflow-marker-text": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "tee-console",
        "capture-stdout",
        "capture-stderr",
        "capture-progress",
        "event-format"
      ],
      "additionalProperties": false
    },
    "default-input-controls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tee-console": {
          "type": "boolean"
        },
        "capture-stdin": {
          "type": "boolean"
        },
        "capture-input-events": {
          "type": "boolean"
        },
        "allow-pause-resume": {
          "type": "boolean"
        },
        "event-format": {
          "type": "string",
          "enum": [
            "ndjson"
          ]
        }
      },
      "required": [
        "enabled",
        "tee-console",
        "capture-stdin",
        "capture-input-events",
        "allow-pause-resume",
        "event-format"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "type": "object"
}
