{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "settings: features",
  "description": "Per-component options and feature switches, keyed by component id: component options, feature enable/options (`<kind>:<id>` keys) and per-implementation options and features. Written by the component commands into the user-project scope (one person's untracked choices for one project); a tracked project file may carry shared defaults. Whether an implementation is enabled is lifecycle state, not configured here; provider policy is providers.<id>.enabled.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[a-z0-9][a-z0-9_-]{0,63}$": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "options": {
          "type": "object"
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9_.-]*$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "options": {
                  "type": "object"
                }
              }
            }
          }
        },
        "implementations": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "options": {
                  "type": "object"
                },
                "features": {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^[a-z0-9][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9_.-]*$": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "options": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
