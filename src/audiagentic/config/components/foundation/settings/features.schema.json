{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "settings: features",
  "description": "User intent for components' implementations and features: whether each is enabled and its options, keyed by component id. Absent means never decided (the descriptor default applies). Provider enablement policy is providers.<id>.enabled, not this section. Availability, qualification and other observations are state, never configured here.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[a-z0-9][a-z0-9_-]{0,63}$": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9_.-]*$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "options": {
                  "type": "object"
                }
              }
            }
          }
        },
        "implementations": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "options": {
                  "type": "object"
                },
                "features": {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^[a-z0-9][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9_.-]*$": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "options": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
