{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract-version",
    "session-id",
    "execution-profile-id",
    "state",
    "binding",
    "timing",
    "activity"
  ],
  "additionalProperties": false,
  "properties": {
    "contract-version": {
      "enum": ["v1", "v2", "v3", "v4"]
    },
    "session-id": {
      "type": "string"
    },
    "created-by-request-id": {
      "type": ["string", "null"]
    },
    "provider-transport-kind": {
      "enum": ["worker", "provider-session"]
    },
    "execution-profile-id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": ["active", "closing", "closed", "expired", "failed"]
    },
    "binding": {
      "type": ["object", "null"],
      "required": [
        "binding-id",
        "generation",
        "provider-id",
        "surface-id",
        "provider-session-ref",
        "provider-ref-key",
        "relation",
        "ownership",
        "identity-context-fingerprint",
        "execution-context-fingerprint",
        "created-at"
      ],
      "additionalProperties": false,
      "properties": {
        "binding-id": {"type": "string"},
        "generation": {"type": "integer", "minimum": 1},
        "provider-id": {"type": ["string", "null"]},
        "surface-id": {"type": "string"},
        "surface-version": {"type": ["string", "null"]},
        "ref-namespace": {"type": "string"},
        "provider-session-ref": {"type": "string"},
        "provider-ref-key": {"type": "string"},
        "relation": {
          "type": "string",
          "enum": ["opened", "attached", "resumed-from", "replaced"]
        },
        "ownership": {
          "type": "string",
          "enum": ["owned", "external", "adopted"]
        },
        "predecessor-binding-id": {"type": ["string", "null"]},
        "identity-context-fingerprint": {"type": "string"},
        "execution-context-fingerprint": {"type": "string"},
        "context-id": {"type": ["string", "null"]},
        "agent-definition-id": {"type": ["string", "null"]},
        "agent-definition-digest": {"type": ["string", "null"]},
        "role-ids": {"type": ["array", "null"], "items": {"type": "string"}},
        "role-set-digest": {"type": ["string", "null"]},
        "execution-profile-digest": {"type": ["string", "null"]},
        "effective-capability-digest": {"type": ["string", "null"]},
        "created-at": {"type": "string"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider-id": {"type": "string"},
        "model-id": {"type": "string"},
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "timing": {
      "type": "object",
      "required": ["created-at", "updated-at", "last-activity-at"],
      "additionalProperties": false,
      "properties": {
        "created-at": {"type": "string"},
        "updated-at": {"type": "string"},
        "last-activity-at": {"type": "string"},
        "last-accepted-turn-at": {"type": "string"},
        "closed-at": {"type": "string"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "idle-timeout-seconds": {"type": "number"},
        "max-lifetime-seconds": {"type": "number"}
      }
    },
    "activity": {
      "type": "object",
      "required": ["turn-count", "request-ids"],
      "additionalProperties": false,
      "properties": {
        "turn-count": {"type": "integer", "minimum": 0},
        "request-ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "retention-claim": {
      "type": "object",
      "description": "Durable claim by a destructive retention operation; while present, resume and continuation admission are refused. Not a lifecycle state.",
      "required": ["operation-id", "claimed-at"],
      "additionalProperties": false,
      "properties": {
        "operation-id": {"type": "string", "minLength": 1, "maxLength": 128},
        "claimed-at": {"type": "string"},
        "stage": {"enum": ["claimed", "deleting"], "description": "claimed: nothing destroyed yet and the claim may be released; deleting: destruction has begun and the claim is kept until the session record itself is removed."},
        "plan": {
          "type": "object",
          "description": "The deletion closure recorded before destruction so a crashed operation can resume it. Identifiers and a digest only; no payloads.",
          "required": ["request-ids", "policy-digest"],
          "additionalProperties": false,
          "properties": {
            "request-ids": {"type": "array", "maxItems": 10000, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
            "policy-digest": {"type": "string", "maxLength": 128}
          }
        }
      }
    },
    "close-reason": {
      "type": "string",
      "enum": [
        "client-request",
        "idle-timeout",
        "max-lifetime",
        "shutdown",
        "cancelled-turn",
        "post-turn-close",
        "failed",
        "orphaned",
        "turn-timeout",
        "turn-silence-timeout",
        "purge"
      ]
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "kind"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "kind": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
