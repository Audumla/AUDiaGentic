{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway task status V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "lifecycle",
    "activity_seq"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "string",
      "enum": ["pending", "active", "terminal"]
    },
    "activity": {
      "type": "string",
      "enum": ["waiting", "running", "cancelling", "completing"]
    },
    "activity_seq": {
      "type": "integer",
      "minimum": 0
    },
    "activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "cancelled",
        "interrupted",
        "rejected",
        "timed-out",
        "expired",
        "abandoned",
        "superseded"
      ]
    }
  }
}
