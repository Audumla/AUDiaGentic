{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway task status V4",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "lifecycle", "activity", "outcome"],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "string",
      "enum": ["pending", "active", "terminal"]
    },
    "activity": {
      "type": ["string", "null"],
      "enum": ["waiting", "running", "cancelling", "completing", null]
    },
    "outcome": {
      "type": ["string", "null"],
      "enum": [
        "success",
        "failed",
        "cancelled",
        "interrupted",
        "rejected",
        "timed-out",
        "expired",
        "abandoned",
        "superseded",
        null
      ]
    }
  }
}
