{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract-version",
    "ok",
    "error-code",
    "error-kind",
    "message",
    "details"
  ],
  "properties": {
    "contract-version": {"const": "v1"},
    "ok": {"const": false},
    "error-code": {
      "type": "string",
      "pattern": "^[A-Z]{2,}-[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-\\d{3}$"
    },
    "error-kind": {"type": "string"},
    "message": {"type": "string"},
    "details": {"type": "object"}
  }
}
