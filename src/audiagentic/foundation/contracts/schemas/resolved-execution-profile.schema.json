{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resolved-execution-profile",
  "type": "object",
  "required": [
    "profile-id",
    "generation",
    "config-digest",
    "provider-id",
    "instances",
    "execution-params"
  ],
  "additionalProperties": false,
  "properties": {
    "profile-id": {
      "type": "string"
    },
    "generation": {
      "type": "string"
    },
    "config-digest": {
      "type": "string"
    },
    "provider-id": {
      "type": "string"
    },
    "instances": {
      "description": "AS105/AS101: the compatible model-sources.yaml source-id set. Free-instance dispatch binds to one of these only at dispatch time, never at admission.",
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "execution-params": {
      "type": "object"
    },
    "resolved-surface-id": {
      "type": ["string", "null"]
    },
    "resolved-surface-version": {
      "type": ["string", "null"]
    }
  }
}
