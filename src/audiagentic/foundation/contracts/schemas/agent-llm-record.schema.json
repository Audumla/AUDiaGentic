{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract-version",
    "request-id",
    "agent-profile-id",
    "mode",
    "state",
    "created-at",
    "updated-at",
    "attempts",
    "fallback-profile-ids",
    "metadata",
    "cancel-requested"
  ],
  "additionalProperties": false,
  "properties": {
    "contract-version": {
      "const": "v1"
    },
    "request-id": {
      "type": "string"
    },
    "agent-profile-id": {
      "type": "string"
    },
    "prompt-body": {
      "type": ["string", "null"]
    },
    "mode": {
      "type": "string",
      "enum": ["async", "blocking"]
    },
    "timeout-seconds": {
      "type": ["number", "null"]
    },
    "fallback-profile-ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source": {
      "type": ["string", "null"]
    },
    "metadata": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "enum": ["queued", "running", "completed", "failed", "cancelled", "rejected"]
    },
    "cancel-requested": {
      "type": "boolean"
    },
    "provider-id": {
      "type": ["string", "null"]
    },
    "model-id": {
      "type": ["string", "null"]
    },
    "output": {
      "type": ["string", "null"]
    },
    "completion": {
      "type": ["object", "null"]
    },
    "usage": {
      "type": ["object", "null"]
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "kind": {"type": "string"}
      },
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent-profile-id", "state", "started-at"],
        "properties": {
          "agent-profile-id": {"type": "string"},
          "provider-id": {"type": ["string", "null"]},
          "model-id": {"type": ["string", "null"]},
          "state": {
            "type": "string",
            "enum": ["running", "completed", "failed"]
          },
          "error": {
            "type": ["object", "null"]
          },
          "started-at": {"type": "string"},
          "finished-at": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "created-at": {
      "type": "string"
    },
    "updated-at": {
      "type": "string"
    },
    "started-at": {
      "type": ["string", "null"]
    },
    "finished-at": {
      "type": ["string", "null"]
    }
  }
}
