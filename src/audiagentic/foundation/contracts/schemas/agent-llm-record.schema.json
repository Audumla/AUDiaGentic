{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract-version",
    "request-id",
    "agent-profile-id",
    "mode",
    "state",
    "created-at",
    "updated-at",
    "attempts",
    "metadata",
    "cancel-requested"
    ,"cancel-acknowledged-at"
    ,"cancel-acknowledged-by"
    ,"revision"
    ,"worker-id"
    ,"attempt-epoch"
    ,"dispatch-owner-epoch"
    ,"dispatch-claimed-at"
    ,"dispatch-service-root"
    ,"recovery"
  ],
  "additionalProperties": false,
  "properties": {
    "contract-version": {
      "const": "v2"
    },
    "request-id": {
      "type": "string"
    },
    "agent-profile-id": {
      "type": "string"
    },
    "prompt-body": {
      "type": ["string", "null"]
    },
    "prompt-digest": {
      "type": ["string", "null"]
    },
    "manifest-id": {
      "type": ["string", "null"]
    },
    "context-fingerprint": {
      "type": ["string", "null"]
    },
    "idempotency-key": {
      "type": ["string", "null"]
    },
    "correlation-id": {
      "type": ["string", "null"]
    },
    "gateway-profile-id": {
      "type": ["string", "null"]
    },
    "gateway-profile-generation": {
      "type": ["string", "null"]
    },
    "gateway-profile-config-digest": {
      "type": ["string", "null"]
    },
    "gateway-execution-lane-key": {
      "type": ["string", "null"]
    },
    "resolved-provider-id": {
      "type": ["string", "null"]
    },
    "resolved-model-id": {
      "type": ["string", "null"]
    },
    "resolved-queue-limits": {
      "type": ["object", "null"],
      "properties": {
        "max-concurrency": {"type": "integer"},
        "queue-max-size": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "admission-policy-digest": {
      "type": ["string", "null"]
    },
    "mode": {
      "type": "string",
      "enum": ["async", "blocking"]
    },
    "timeout-seconds": {
      "type": ["number", "null"]
    },
    "source": {
      "type": ["string", "null"]
    },
    "session-id": {
      "type": ["string", "null"]
    },
    "session-keep-alive": {
      "type": ["boolean", "null"]
    },
    "session-idle-timeout-seconds": {
      "type": ["number", "null"]
    },
    "session-max-lifetime-seconds": {
      "type": ["number", "null"]
    },
    "metadata": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "enum": ["queued", "running", "completed", "failed", "cancelled", "rejected", "interrupted"]
    },
    "cancel-requested": {
      "type": "boolean"
    },
    "cancel-acknowledged-at": {
      "type": ["string", "null"]
    },
    "cancel-acknowledged-by": {
      "type": ["string", "null"]
    },
    "revision": {"type": "integer", "minimum": 0},
    "worker-id": {"type": ["string", "null"]},
    "attempt-epoch": {"type": "integer", "minimum": 0},
    "dispatch-owner-epoch": {"type": ["string", "null"]},
    "dispatch-claimed-at": {"type": ["string", "null"]},
    "dispatch-service-root": {"type": ["string", "null"]},
    "recovery": {
      "type": ["object", "null"],
      "required": ["reason", "outcome"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["service-restart", "unproven-dispatch", "unproven-execution"]
        },
        "outcome": {
          "type": "string",
          "enum": ["resubmit-required", "replay-required", "manual-review-required"]
        }
      },
      "additionalProperties": false
    },
    "replay-required": {
      "type": ["boolean", "null"]
    },
    "replay-reason": {
      "type": ["string", "null"]
    },
    "replayed-by-request-id": {
      "type": ["string", "null"]
    },
    "resumed-from-request-id": {
      "type": ["string", "null"]
    },
    "provider-id": {
      "type": ["string", "null"]
    },
    "model-id": {
      "type": ["string", "null"]
    },
    "output": {
      "type": ["string", "null"]
    },
    "completion": {
      "type": ["object", "null"]
    },
    "usage": {
      "type": ["object", "null"]
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "kind": {"type": "string"}
      },
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent-profile-id", "state", "started-at"],
        "properties": {
          "agent-profile-id": {"type": "string"},
          "provider-id": {"type": ["string", "null"]},
          "model-id": {"type": ["string", "null"]},
          "state": {
            "type": "string",
            "enum": ["running", "completed", "failed", "cancelled"]
          },
          "error": {
            "type": ["object", "null"]
          },
          "started-at": {"type": "string"},
          "finished-at": {"type": ["string", "null"]}
          ,"worker-id": {"type": ["string", "null"]}
          ,"attempt-epoch": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "created-at": {
      "type": "string"
    },
    "updated-at": {
      "type": "string"
    },
    "started-at": {
      "type": ["string", "null"]
    },
    "finished-at": {
      "type": ["string", "null"]
    }
  }
}
