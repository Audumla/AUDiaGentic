{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiagentic.dev/schemas/agent-file.schema.json",
  "title": "AUDiaGentic agent or agent template file",
  "description": "One agent per file in a scope's agents/ directory, or one template in templates/ (docs/design/configuration-model.md). Files are sparse: higher scopes merge-patch (RFC 7396) over lower ones with the same id, and an agent may extend one template. Field names follow the A2A Agent Card where one exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Must match the file name when given."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "uniqueItems": true
    },
    "extends": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Template id (agents only; one level)."
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Session surface; defaults to the provider's only surface."
    },
    "params": {
      "type": "object"
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "instructions_file": {
      "type": "string",
      "minLength": 1,
      "description": "Plain text file, relative to this file."
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "Request wrapper; defaults to '{prompt-body}'."
    }
  }
}
