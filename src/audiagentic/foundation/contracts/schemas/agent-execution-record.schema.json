{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract-version",
    "request-id",
    "execution-profile-id",
    "mode",
    "state",
    "created-at",
    "updated-at",
    "attempts",
    "metadata",
    "cancel-requested"
    ,"cancel-acknowledged-at"
    ,"cancel-acknowledged-by"
    ,"revision"
    ,"worker-id"
    ,"attempt-epoch"
    ,"dispatch-owner-epoch"
    ,"dispatch-claimed-at"
    ,"dispatch-service-root"
    ,"recovery"
    ,"recovery-required"
    ,"resolved-source-id"
    ,"resolved-capacity-generation"
    ,"last-activity-at"
    ,"activity-sequence"
    ,"activity-source"
    ,"activity-lease-expires-at"
  ],
  "allOf": [{
    "if": {"properties": {"contract-version": {"enum": ["v9", "v10", "v11"]}}, "required": ["contract-version"]},
    "then": {"required": ["node-dispatch", "node-placement"]}
  }, {
    "if": {"properties": {"contract-version": {"enum": ["v10", "v11"]}}, "required": ["contract-version"]},
    "then": {"properties": {"node-dispatch": {"required": ["attestation-sha256"]}}}
  }, {
    "if": {"properties": {"contract-version": {"const": "v11"}}, "required": ["contract-version"]},
    "then": {"required": ["node-admission"]}
  }],
  "additionalProperties": false,
  "properties": {
    "node-admission": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "version",
        "server-id",
        "semantic",
        "policy",
        "snapshot-sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "server-id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "maxLength": 200
        },
        "semantic": {
          "type": "object",
          "required": [
            "composition-fingerprint",
            "prompt-definition-fingerprint",
            "prompt-id",
            "execution-profile-id",
            "expanded-prompt-version",
            "expanded-prompt-sha256",
            "raw-prompt-sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "composition-fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 64
            },
            "prompt-definition-fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 64
            },
            "prompt-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "maxLength": 200
            },
            "execution-profile-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "maxLength": 200
            },
            "expanded-prompt-version": {
              "type": "integer",
              "const": 1
            },
            "expanded-prompt-sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 64
            },
            "raw-prompt-sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 64
            }
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "profile-id",
            "generation",
            "config-digest",
            "pending-capacity",
            "global-capacity",
            "project-capacity"
          ],
          "additionalProperties": false,
          "properties": {
            "profile-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "maxLength": 200
            },
            "generation": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "maxLength": 200
            },
            "config-digest": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "maxLength": 200
            },
            "pending-capacity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "global-capacity": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 2147483647
            },
            "project-capacity": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        "source-workspace": {
          "description": "Caller execution identity; authentication and local binding proof are checked by admission. No root path is stored here.",
          "type": "object",
          "required": ["version", "source-node-id", "workspace-id", "access-mode", "binding-sha256"],
          "additionalProperties": false,
          "properties": {
            "version": {"type": "integer", "const": 1},
            "source-node-id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$", "maxLength": 200},
            "workspace-id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$", "maxLength": 200},
            "access-mode": {"enum": ["read-write", "read-only"]},
            "binding-sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64}
          }
        },
        "snapshot-sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        }
      },
      "default": null
    },
    "node-placement": {
      "description": "Immutable admission placement supplied only by the trusted shared service owner; not effect authorization.",
      "default": null,
      "type": ["object", "null"],
      "required": ["node-id", "workspace-id", "principal-id", "server-project-id", "grant-revision"],
      "properties": {
        "node-id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"},
        "workspace-id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"},
        "principal-id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"},
        "server-project-id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"},
        "grant-revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      },
      "additionalProperties": false
    },
    "node-dispatch": {
      "default": null,
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "identity",
        "authorization-id",
        "authorization-state",
        "receipt-sequence",
        "receipt-sha256",
        "receipt-stage",
        "output-sha256"
      ],
      "properties": {
        "attestation-sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "default": null,
          "description": "Digest of the accepted preparation attestation; null is historical evidence only."
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command-id",
            "request-id",
            "node-id",
            "node-epoch",
            "gateway-owner-epoch",
            "connection-generation",
            "workspace-id",
            "grant-revision",
            "binding-generation",
            "payload-sha256",
            "execution-profile-id"
          ],
          "properties": {
            "command-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            "request-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            "node-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            "node-epoch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            "gateway-owner-epoch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            "connection-generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "workspace-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            "grant-revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "binding-generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "payload-sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "execution-profile-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            }
          }
        },
        "authorization-id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            }
          ]
        },
        "authorization-state": {
          "enum": [
            "not-authorized",
            "authorized",
            "effect-observed",
            "uncertain",
            "terminal"
          ]
        },
        "receipt-sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "receipt-sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "receipt-stage": {
          "enum": [
            null,
            "prepared",
            "effect-intent",
            "native-accepted",
            "terminal"
          ]
        },
        "output-sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "client-default-session": {
      "type": ["object", "null"],
      "properties": {
        "key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "automatic": {"type": "boolean"},
        "schema-generation": {"type": "integer", "minimum": 1},
        "logical-client-id": {"type": ["string", "null"], "minLength": 1},
        "provider-surface": {"type": ["string", "null"], "minLength": 1}
      },
      "required": ["key", "automatic"], "additionalProperties": false
    },
    "warnings": {"type": "array", "maxItems": 3, "items": {
      "type": "object", "properties": {
        "code": {"type": "string", "maxLength": 80}, "message": {"type": "string", "maxLength": 240},
        "session-id": {"type": "string"}
      }, "required": ["code", "message"], "additionalProperties": false
    }},
    "contract-version": {
      "enum": ["v5", "v6", "v7", "v8", "v9", "v10", "v11"]
    },
    "request-id": {
      "type": "string"
    },
    "agent-id": {
      "type": ["string", "null"]
    },
    "execution-profile-id": {
      "type": "string"
    },
    "prompt-profile-id": {
      "type": "string",
      "minLength": 1
    },
    "prompt-template-name": {"type": ["string", "null"]},
    "prompt-template-digest": {"type": ["string", "null"]},
    "prompt-definition-fingerprint": {"type": ["string", "null"]},
    "response-artifact": {
      "type": ["object", "null"],
      "properties": {
        "artifact-id": {"const": "final-response"},
        "request-id": {"type": "string"},
        "media-type": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "minLength": 1}
      },
      "required": ["artifact-id", "request-id", "media-type", "bytes", "sha256"],
      "additionalProperties": false
    },
    "failure-response-artifact": {
      "type": ["object", "null"],
      "properties": {
        "artifact-id": {"const": "failure-response"},
        "request-id": {"type": "string"},
        "media-type": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "minLength": 1}
      },
      "required": ["artifact-id", "request-id", "media-type", "bytes", "sha256"],
      "additionalProperties": false
    },
    "failure-response-preview": {"type": ["string", "null"]},
    "failure-response-truncated": {"type": "boolean"},
    "output-preview": {"type": ["string", "null"]},
    "output-truncated": {"type": "boolean"},
    "prompt-body": {
      "type": ["string", "null"]
    },
    "prompt-digest": {
      "type": ["string", "null"]
    },
    "manifest-id": {
      "type": ["string", "null"]
    },
    "context-fingerprint": {
      "type": ["string", "null"]
    },
    "idempotency-key": {
      "type": ["string", "null"]
    },
    "correlation-id": {
      "type": ["string", "null"]
    },
    "gateway-profile-id": {
      "type": ["string", "null"]
    },
    "gateway-profile-generation": {
      "type": ["string", "null"]
    },
    "gateway-profile-config-digest": {
      "type": ["string", "null"]
    },
    "gateway-profile-runtime": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider-id": {"type": "string"},
        "instances": {"type": "array", "items": {"type": "string"}},
        "params": {"type": "object", "additionalProperties": true},
        "model-alias": {"type": ["string", "null"]},
        "surface-id": {"type": ["string", "null"]},
        "surface-version": {"type": ["string", "null"]}
      }
    },
    "resolved-provider-id": {
      "type": ["string", "null"]
    },
    "resolved-model-id": {
      "type": ["string", "null"]
    },
    "resolved-model-selector": {
      "description": "Provider-native model selector frozen with the scheduler placement; adapters may encode it into their transport without re-reading model configuration.",
      "type": ["string", "null"]
    },
    "resolved-source-id": {
      "description": "AS101: concrete model-sources source selected by the scheduler. It remains null while queued and is atomically written with the owned transition to running before provider invocation.",
      "type": ["string", "null"]
    },
    "resolved-capacity-generation": {
      "description": "AS101: capacity snapshot generation from which resolved-source-id was reserved.",
      "type": ["string", "null"]
    },
    "last-activity-at": {
      "description": "SH22 gateway-received timestamp of last accepted request/attempt-bound activity; never worker-supplied time.",
      "type": ["string", "null"]
    },
    "activity-sequence": {
      "description": "SH22 last accepted strictly increasing worker activity sequence for the current attempt.",
      "type": "integer",
      "minimum": 0
    },
    "activity-source": {
      "type": ["string", "null"]
    },
    "activity-lease-expires-at": {
      "type": ["string", "null"]
    },
    "activity": {
      "type": "object",
      "required": ["sequence", "last-at", "last-source", "provider", "owner"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "last-at": {"type": ["string", "null"]},
        "last-source": {"type": ["string", "null"]},
        "provider": {
          "type": "object",
          "required": ["capability", "last-at", "lease-expires-at", "source", "source-instance", "source-sequence", "phase"],
          "properties": {
            "capability": {"enum": ["unsupported", "supported", "unknown"]},
            "first-at": {"type": ["string", "null"]},
            "last-at": {"type": ["string", "null"]},
            "lease-expires-at": {"type": ["string", "null"]},
            "source": {"type": ["string", "null"]},
            "source-instance": {"type": ["string", "null"]},
            "source-sequence": {"type": "integer", "minimum": 0},
            "phase": {"type": ["string", "null"]},
            "activity-label": {"type": ["string", "null"], "maxLength": 128},
            "activity-group": {"type": ["string", "null"], "maxLength": 64}
          },
          "additionalProperties": false
        },
        "owner": {
          "type": "object",
          "required": ["last-at", "lease-expires-at", "source", "source-instance", "source-sequence"],
          "properties": {
            "last-at": {"type": ["string", "null"]},
            "lease-expires-at": {"type": ["string", "null"]},
            "source": {"type": ["string", "null"]},
            "source-instance": {"type": ["string", "null"]},
            "source-sequence": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "watchdog-state": {
      "type": ["string", "null"],
      "enum": ["not-started", "active", "unknown", "intervention", "terminal", null]
    },
    "watchdog-reason": {
      "type": ["string", "null"]
    },
    "terminal-classification": {
      "type": ["string", "null"],
      "enum": ["cancelled", "worker-process-exited", "provider-terminal-error", "verified-stall", "absolute-safety-ceiling", null]
    },
    "terminal-finalization": {
      "type": "object",
      "properties": {
        "session-id": {"type": "string", "minLength": 1},
        "recovered-binding": {"type": "object", "additionalProperties": true},
        "clear-unresolved-turn": {"type": "boolean"},
        "pre-clear-checkpoint": {
          "description": "Private frozen checkpoint retained until captured observer handoff.",
          "type": "object", "maxProperties": 64, "additionalProperties": true
        },
        "expected-session-binding": {
          "type": ["object", "null"], "additionalProperties": true
        },
        "capture-owner": {
          "type": "object",
          "properties": {
            "dispatch-owner-epoch": {"type": ["string", "null"]},
            "worker-id": {"type": ["string", "null"]},
            "attempt-epoch": {"type": ["integer", "null"]}
          },
          "required": ["dispatch-owner-epoch", "worker-id", "attempt-epoch"],
          "additionalProperties": false
        }
      },
      "required": ["session-id", "recovered-binding", "clear-unresolved-turn"],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": ["object", "null"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "classification": {
          "type": "string",
          "enum": [
            "provider-rejected",
            "provider-error",
            "browser-adapter-error",
            "gateway-ownership-queue-error",
            "gateway-restart",
            "cancelled",
            "timeout",
            "stale-progress",
            "ambiguous-side-effect",
            "unknown"
          ]
        },
        "certainty": {"type": "string"},
        "phase": {"type": "string"},
        "side-effect-state": {"type": "string"},
        "resolution-state": {"type": "string"},
        "failure-code": {"type": ["string", "null"]},
        "reason-code": {"type": ["string", "null"]},
        "provider-signals": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 128}},
        "evidence-count": {"type": "integer", "minimum": 0},
        "coalesced-observation-count": {"type": "integer", "minimum": 0},
        "recovery": {
          "type": "object",
          "properties": {
            "disposition": {"type": "string"},
            "allowed-actions": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 64}}
          },
          "required": ["disposition", "allowed-actions"],
          "additionalProperties": false
        }
      },
      "required": ["version", "classification", "certainty", "phase", "side-effect-state", "resolution-state", "evidence-count", "coalesced-observation-count", "recovery"],
      "additionalProperties": false
    },
    "diagnostic-evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "evidence-id": {"type": "string", "maxLength": 128},
          "sequence": {"type": "integer", "minimum": 0},
          "request-id": {"type": ["string", "null"], "maxLength": 128},
          "session-id": {"type": ["string", "null"], "maxLength": 128},
          "attempt-epoch": {"type": "integer", "minimum": 0},
          "phase": {"type": "string", "maxLength": 64},
          "kind": {"type": "string", "maxLength": 64},
          "certainty": {"type": "string", "maxLength": 32},
          "side-effect-state": {"type": "string", "maxLength": 64},
          "source": {"type": ["string", "null"], "maxLength": 128},
          "source-sequence": {"type": ["integer", "null"], "minimum": 0},
          "activity-label": {"type": "string", "maxLength": 128},
          "activity-group": {"type": "string", "maxLength": 64}
        },
        "required": ["evidence-id", "sequence", "phase", "kind", "certainty", "side-effect-state"],
        "additionalProperties": false
      }
    },
    "watchdog-policy": {
      "type": ["object", "null"],
      "properties": {
        "policy-id": {"type": "string"},
        "policy-digest": {"type": "string"},
        "activity-lease-seconds": {"type": "number", "exclusiveMinimum": 0},
        "absolute-safety-ceiling-seconds": {"type": "number", "minimum": 0},
        "diagnostic-grace-seconds": {"type": "number", "exclusiveMinimum": 0},
        "initial-activity-grace-seconds": {"type": "number", "exclusiveMinimum": 0},
        "available": {"type": "boolean"}
      },
      "required": ["policy-id", "policy-digest", "activity-lease-seconds", "absolute-safety-ceiling-seconds", "diagnostic-grace-seconds", "available"],
      "additionalProperties": false
    },
    "resolved-instance-ids": {
      "description": "AS105/AS101: the admitted compatible model-sources.yaml source-id set (ResolvedExecutionProfile.instances at admission time). Absent on records predating the free-instance dispatch migration -- snapshot_from_record() fails closed on those rather than misparsing them.",
      "type": ["array", "null"],
      "items": {"type": "string"}
    },
    "mode": {
      "type": "string",
      "enum": ["async", "blocking"]
    },
    "timeout-seconds": {
      "type": ["number", "null"]
    },
    "source": {
      "type": ["string", "null"]
    },
    "session-id": {
      "type": ["string", "null"]
    },
    "continuation-session-id": {
      "description": "The caller-supplied provider-session continuation identity, if any. It is deliberately distinct from the request-owned durable gateway session-id.",
      "type": ["string", "null"]
    },
    "provider-transport-kind": {
      "description": "Immutable dispatch transport selected at admission. Every v8 request has a durable gateway session, but only provider-session requests use SessionRuntime.",
      "enum": ["worker", "provider-session"]
    },
    "provider-metadata": {
      "description": "Opaque provider-owned runtime metadata retained for diagnostics and session restoration. GPT-auto may provide project-url, chat-url, and provider-session-id; compact task status intentionally projects only the safe provider-turn-pending flag.",
      "type": ["object", "null"],
      "properties": {
        "project-url": {"type": ["string", "null"], "maxLength": 4096},
        "chat-url": {"type": ["string", "null"], "maxLength": 4096},
        "provider-session-id": {"type": ["string", "null"], "maxLength": 1024}
      },
      "additionalProperties": true
    },
    "session-keep-alive": {
      "type": ["boolean", "null"]
    },
    "session-idle-timeout-seconds": {
      "type": ["number", "null"]
    },
    "session-max-lifetime-seconds": {
      "type": ["number", "null"]
    },
    "metadata": {
      "type": "object"
    },
    "template-context": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "state": {
      "type": "string",
      "enum": ["queued", "running", "completed", "failed", "cancelled", "rejected", "interrupted"]
    },
    "cancel-requested": {
      "type": "boolean"
    },
    "cancel-acknowledged-at": {
      "type": ["string", "null"]
    },
    "cancel-acknowledged-by": {
      "type": ["string", "null"]
    },
    "cancel-provenance": {
