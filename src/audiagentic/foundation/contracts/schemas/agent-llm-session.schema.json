{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract-version",
    "session-id",
    "agent-profile-id",
    "state",
    "binding",
    "request-ids",
    "turn-count",
    "created-at",
    "updated-at"
  ],
  "additionalProperties": false,
  "properties": {
    "contract-version": {
      "enum": ["v1", "v2"]
    },
    "session-id": {
      "type": "string"
    },
    "agent-profile-id": {
      "type": "string"
    },
    "provider-id": {
      "type": ["string", "null"]
    },
    "model-id": {
      "type": ["string", "null"]
    },
    "binding": {
      "type": ["object", "null"],
      "required": [
        "binding-id",
        "generation",
        "provider-id",
        "surface-id",
        "provider-session-ref",
        "provider-ref-key",
        "relation",
        "ownership",
        "identity-context-fingerprint",
        "execution-context-fingerprint",
        "created-at"
      ],
      "additionalProperties": false,
      "properties": {
        "binding-id": {"type": "string"},
        "generation": {"type": "integer", "minimum": 1},
        "provider-id": {"type": ["string", "null"]},
        "surface-id": {"type": "string"},
        "surface-version": {"type": ["string", "null"]},
        "ref-namespace": {"type": "string"},
        "provider-session-ref": {"type": "string"},
        "provider-ref-key": {"type": "string"},
        "relation": {
          "type": "string",
          "enum": ["opened", "attached", "resumed-from", "replaced"]
        },
        "ownership": {
          "type": "string",
          "enum": ["owned", "external", "adopted"]
        },
        "predecessor-binding-id": {"type": ["string", "null"]},
        "identity-context-fingerprint": {"type": "string"},
        "execution-context-fingerprint": {"type": "string"},
        "created-at": {"type": "string"}
      }
    },
    "state": {
      "type": "string",
      "enum": ["active", "closing", "closed", "expired", "failed"]
    },
    "close-reason": {
      "type": ["string", "null"],
      "enum": [
        "client-request",
        "idle-timeout",
        "max-lifetime",
        "shutdown",
        "cancelled-turn",
        "failed",
        "orphaned",
        "turn-timeout",
        "turn-stalled",
        null
      ]
    },
    "idle-timeout-seconds": {
      "type": ["number", "null"]
    },
    "max-lifetime-seconds": {
      "type": ["number", "null"]
    },
    "request-ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "turn-count": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "kind": {"type": "string"}
      },
      "additionalProperties": false
    },
    "created-at": {
      "type": "string"
    },
    "updated-at": {
      "type": "string"
    },
    "last-activity-at": {
      "type": ["string", "null"]
    },
    "closed-at": {
      "type": ["string", "null"]
    }
  }
}
