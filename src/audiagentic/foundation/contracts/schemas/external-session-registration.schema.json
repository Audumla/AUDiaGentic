{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiagentic.dev/schemas/external-session-registration.schema.json",
  "title": "External session registration (SH50a)",
  "description": "Gateway-canonical registration of one already-running provider session the gateway may drive but does not own, keyed by the provider-ref key. Carries the opaque node locator, the join basis proven by the Provider authority, a monotonic binding generation and at most one active writer claim. Generated state, never configuration. A registration is not an authorization grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "ref-key",
    "provider-id",
    "surface-id",
    "node-locator",
    "generation",
    "basis",
    "writer",
    "created-at",
    "updated-at"
  ],
  "properties": {
    "schema-version": {
      "const": 1
    },
    "ref-key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider-id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "surface-id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "node-locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Opaque to the gateway; never parsed, logged or returned to callers."
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "description": "Binding generation; increases whenever the basis or locator changes."
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence-id",
        "executable-digest",
        "executable-version",
        "instance-generation"
      ],
      "properties": {
        "evidence-id": {
          "type": "string",
          "pattern": "^qe_[0-9a-f]{24}$"
        },
        "executable-digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "executable-version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "instance-generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "writer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "writer-id",
            "claimed-at"
          ],
          "properties": {
            "writer-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "claimed-at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "created-at": {
      "type": "string",
      "format": "date-time"
    },
    "updated-at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
