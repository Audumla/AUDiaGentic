{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StatusEvidence",
  "description": "Bounded neutral observation of agent/request status. Foundation-owned contract, no provider-specific fields.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "description": "Canonical status value (e.g. 'model-thinking', 'tool-calling', 'waiting-permission')"
    },
    "session-id": {
      "type": "string",
      "description": "AG session ID"
    },
    "request-id": {
      "type": ["string", "null"],
      "description": "AG request ID, or null for session-level events"
    },
    "correlation-id": {
      "type": ["string", "null"],
      "description": "User-provided correlation ID"
    },
    "observed-at": {
      "type": "string",
      "description": "ISO-8601 timestamp"
    },
    "sequence": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Monotonic sequence within the turn, or null"
    },
    "source-kind": {
      "type": "string",
      "enum": ["transport-observation", "managed-hook", "managed-plugin", "structured-output"],
      "description": "Source mechanism for this observation"
    },
    "semantic-strength": {
      "type": "string",
      "enum": ["unknown", "inferred", "execution"],
      "description": "How strongly this observation is semantically meaningful"
    },
    "verification-tier": {
      "type": "string",
      "description": "Verification tier (e.g. 'unknown', 'documented', 'proven')"
    }
  },
  "required": ["status", "session-id", "observed-at", "source-kind"],
  "additionalProperties": false
}
