{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event Topics Registry",
  "description": "Validates events.yaml \u00e2\u20ac\u201d per-component event topic registry. Keys are topic names; values are topic specs.",
  "type": "object",
  "patternProperties": {
    "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]+)+$": {
      "$ref": "#/definitions/TopicSpec"
    }
  },
  "additionalProperties": false,
  "minProperties": 1,
  "definitions": {
    "TopicSpec": {
      "type": "object",
      "required": [
        "description",
        "payload-required"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "payload-required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payload-optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata-keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery": {
          "type": "string",
          "enum": [
            "sync",
            "async",
            "both"
          ]
        },
        "since": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
