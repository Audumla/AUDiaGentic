{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "change-class",
    "files",
    "technical-summary",
    "user-summary-candidate",
    "status"
  ],
  "properties": {
    "change-class": {
      "type": "string",
      "enum": [
        "feature",
        "code-fix",
        "refactor",
        "docs",
        "tests",
        "config",
        "release",
        "audit",
        "workflow"
      ],
      "description": "Change category."
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Relative file paths changed from project root."
    },
    "technical-summary": {
      "type": "string",
      "description": "Detailed what-andwhy — the audit trail."
    },
    "user-summary-candidate": {
      "type": "string",
      "description": "Concise changelog-style summary."
    },
    "status": {
      "type": "string",
      "enum": [
        "unreleased",
        "released"
      ],
      "description": "Always 'unreleased' when recording. Archive stamps 'released'."
    },
    "release-id": {
      "type": "string",
      "description": "Stamped by archive when status transitions to released."
    },
    "git-commits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 7
      },
      "uniqueItems": true,
      "description": "Git commit SHAs from post-commit hook. Append-only. Do not set manually."
    },
    "plan-item-ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plan item IDs associated with this change event for automatic ledger-to-plan linkage."
    }
  }
}
