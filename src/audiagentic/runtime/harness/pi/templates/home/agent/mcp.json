{
  "settings": {
    "toolPrefix": "mcp",
    "idleTimeout": 10,
    "directTools": true
  },
  "mcpServers": {
    "ag-session-mgmt": {
      "command": "__AUDIAGENTIC_PYTHON__",
      "args": [
        "-m",
        "audiagentic.components.core.session_manage_mcp",
        "--readonly",
        "--smoke-only"
      ],
      "env": {
        "PYTHONPATH": "__AUDIAGENTIC_SRC__",
        "AUDIAGENTIC_REPO_ROOT": "__AUDIAGENTIC_REPO_ROOT__"
      },
      "lifecycle": "lazy",
      "directTools": [
        "status",
        "config",
        "set_auto_update"
      ]
    },
    "ag-project-mgmt": {
      "command": "__AUDIAGENTIC_PYTHON__",
      "args": [
        "-m",
        "audiagentic.components.core.project_manage_mcp"
      ],
      "env": {
        "PYTHONPATH": "__AUDIAGENTIC_SRC__",
        "AUDIAGENTIC_REPO_ROOT": "__AUDIAGENTIC_REPO_ROOT__"
      },
      "lifecycle": "lazy"
    }
  }
}
