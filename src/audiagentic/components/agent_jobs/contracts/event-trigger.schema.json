{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event Trigger Config",
  "description": "Project-scoped event-trigger configuration for agent jobs. Component-only schema (EDJ19).",
  "type": "object",
  "$defs": {
    "filter": {
      "title": "payload/metadata filter conditions (EDJ15)",
      "description": "Dotted paths resolved against {payload, metadata}; scalar values match by equality, lists by membership; all clauses AND. No expressions, comparisons, or boolean composition.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$"
      },
      "additionalProperties": {
        "oneOf": [
          {"type": ["string", "integer", "boolean"]},
          {
            "type": "array",
            "minItems": 1,
            "oneOf": [
              {"items": {"type": "string"}},
              {"items": {"type": "integer"}},
              {"items": {"type": "boolean"}}
            ]
          }
        ]
      }
    }
  },
  "oneOf": [
    {
      "title": "inline prompt-template",
      "type": "object",
      "required": ["contract-version", "trigger-id", "kind", "prompt-template"],
      "properties": {
        "contract-version": {"const": "v1"},
        "trigger-id": {"type": "string"},
        "kind": {"enum": ["event"]},
        "enabled": {"type": "boolean"},
        "event-pattern": {"type": "string"},
        "execution-profile-id": {"type": "string"},
        "workflow-profile": {
          "type": "string",
          "enum": ["lite", "standard", "strict"]
        },
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["packet", "job", "artifact", "adhoc"]
            },
            "packet-id": {"type": "string"},
            "job-id": {"type": "string"},
            "artifact-path": {"type": "string"},
            "adhoc-id": {"type": "string"}
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        "prompt-template": {"type": "string"},
        "filter": {"$ref": "#/$defs/filter"},
        "metadata-propagation": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    {
      "title": "file-based prompt-template-file",
      "type": "object",
      "required": ["contract-version", "trigger-id", "kind", "prompt-template-file"],
      "properties": {
        "contract-version": {"const": "v1"},
        "trigger-id": {"type": "string"},
        "kind": {"enum": ["event"]},
        "enabled": {"type": "boolean"},
        "event-pattern": {"type": "string"},
        "execution-profile-id": {"type": "string"},
        "workflow-profile": {
          "type": "string",
          "enum": ["lite", "standard", "strict"]
        },
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["packet", "job", "artifact", "adhoc"]
            },
            "packet-id": {"type": "string"},
            "job-id": {"type": "string"},
            "artifact-path": {"type": "string"},
            "adhoc-id": {"type": "string"}
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        "prompt-template-file": {"type": "string"},
        "filter": {"$ref": "#/$defs/filter"},
        "metadata-propagation": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  ]
}
