{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-source-catalog.schema.json",
  "type": "object",
  "required": ["contract-version", "models"],
  "properties": {
    "contract-version": {
      "const": "v1"
    },
    "source-id": {
      "type": "string"
    },
    "discovery-mode": {
      "type": "string",
      "enum": ["static-catalog", "list-api"]
    },
    "fetched-at": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model-id"],
        "properties": {
          "model-id": { "type": "string" },
          "display-name": { "type": "string" },
          "context-window": { "type": "integer", "minimum": 1 },
          "max-output-tokens": { "type": "integer", "minimum": 1 },
          "capabilities": {
            "type": "object",
            "properties": {
              "tool-use": { "type": "boolean" },
              "reasoning": { "type": "boolean" },
              "vision": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
