{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiagentic.dev/schemas/providers/provider-recipe.schema.json",
  "title": "Provider Recipe Definition",
  "description": "Internal declarative metadata for one explicitly registered provider automation implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipe-id",
    "provider-id",
    "family-id",
    "supported-modes",
    "payload-contract",
    "result-contract",
    "recipe-version",
    "ownership-scope-required"
  ],
  "properties": {
    "recipe-id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
    },
    "provider-id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "family-id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "supported-modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["plan", "apply", "prune", "status"]
      }
    },
    "payload-contract": {
      "type": "string",
      "minLength": 1
    },
    "result-contract": {
      "type": "string",
      "minLength": 1
    },
    "recipe-version": {
      "type": "string",
      "minLength": 1
    },
    "ownership-scope-required": {
      "type": "boolean"
    },
    "provenance-ref": {
      "type": ["string", "null"],
      "minLength": 1
    }
  }
}
