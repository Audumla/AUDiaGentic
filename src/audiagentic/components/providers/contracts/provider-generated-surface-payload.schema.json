{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiagentic.dev/schemas/providers/provider-generated-surface-payload.schema.json",
  "title": "Generated Provider Surface Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["ownership_scope", "contribution_ids"],
  "properties": {
    "ownership_scope": {"type": "string", "minLength": 1},
    "contribution_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
