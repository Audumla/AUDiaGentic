{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider Model Projection Payload",
  "description": "Typed payload for model-projection automation family.",
  "type": "object",
  "properties": {
    "managed_ids": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Managed IDs for the desired model entries"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {"type": "string"},
          "model_id": {"type": "string"},
          "visible_name": {"type": "string"},
          "connector": {"type": "string"},
          "managed_id": {"type": "string"},
          "vendor_id": {"type": ["string", "null"]},
          "endpoint": {"type": "object"},
          "capabilities": {"type": "object"},
          "limits": {"type": "object"},
          "auth_ref": {"type": ["string", "null"]}
        },
        "required": ["source_id", "model_id", "connector", "managed_id"]
      }
    }
  },
  "required": ["managed_ids", "entries"]
}
