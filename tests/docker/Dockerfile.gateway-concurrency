FROM audia-test-base:latest

WORKDIR /app
ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_GATEWAY_CONCURRENCY_DOCKER=1
ENV PYTHONPATH="/app/src"
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Real concurrent load against a real gateway service SUBPROCESS and a real
# local HTTP rig: max-concurrency genuinely bounding simultaneous dispatch,
# two projects sharing one gateway-owned profile lane, queue-max-size
# rejection, and reload-vs-in-flight-load races. Complements
# Dockerfile.gateway-crash-matrix (crash/recovery) and Dockerfile.gateway-opencode
# (real CLI happy path) — this is the concurrency-focused suite.
#
# Build:
#   docker build -f tests/docker/Dockerfile.gateway-concurrency -t audiagentic-gateway-concurrency:local .
# Run:
#   docker run --rm audiagentic-gateway-concurrency:local
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests

CMD ["bash", "-c", "uv venv /venv && uv pip install --python /venv/bin/python -q --no-compile -e '.[mcp,test]' && /venv/bin/pytest tests/integration/agents/test_gateway_concurrency.py -q --tb=short --timeout=180"]
