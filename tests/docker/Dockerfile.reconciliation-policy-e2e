FROM audia-test-base:latest

WORKDIR /app
ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_REAL_PROVIDER_CLI_TESTS=1
ENV HOME=/tmp/audiagentic-test-home
ENV AUDIAGENTIC_HOME=/tmp/audiagentic-test-home/.audiagentic
ENV PYTHONPATH="/app/src"
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# ON01-ON03 (onboarding-policy plan): reconciliation-policy e2e against real
# provider CLIs, never monkeypatched probes.
#
# opencode + pi are baked in at BUILD time ("already installed" scenario) —
# same npm packages their own descriptors/install hooks declare
# (opencode.yaml cli-install, pi/hooks.py:_pi_install). codex + claude are
# deliberately NOT baked in here: the test itself installs them live via the
# real install_provider_cli path, proving the real network-install case
# rather than a pre-baked one.
#
# Build: docker build -f tests/docker/Dockerfile.reconciliation-policy-e2e -t audiagentic-reconciliation-policy-e2e .
# Run:   docker run --rm audiagentic-reconciliation-policy-e2e
RUN npm install --global \
        opencode-ai \
        @earendil-works/pi-coding-agent \
        pi-mcp-adapter \
        pi-acp \
    && opencode --version \
    && pi --version

COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests

RUN mkdir -p .audiagentic/runtime

ENV PATH="/venv/bin:$PATH"
RUN uv venv /venv && \
    uv pip install --python /venv/bin/python -q --no-compile \
        -e '.[mcp]' pytest pytest-asyncio pytest-timeout pytest-xdist

CMD ["/venv/bin/pytest", "tests/integration/providers/test_reconciliation_policy_real_cli_e2e.py", "-v", "--tb=short", "--timeout=600"]
