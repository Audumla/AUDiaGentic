FROM audia-test-base:latest

WORKDIR /app
ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_PI_ACP_RESUME_E2E_DOCKER=1
ENV HOME=/tmp/audiagentic-test-home
ENV AUDIAGENTIC_HOME=/tmp/audiagentic-test-home/.audiagentic
ENV PYTHONPATH="/app/src"
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# AS49 validate-first: real npm-installed Pi CLI + real pi-acp bridge
# (resolved on demand via `npx --yes pi-acp`, see resolve_system_pi_acp_argv)
# + real embedded llama-server rig, driven through AUDiaGentic's OWN
# AcpAgentSessionTransport.open()/open_resumed() code (not hand-rolled wire
# scripting) -- the same install-then-run pattern as Dockerfile.gateway-pi-smoke
# / Dockerfile.pi-rpc-tap-e2e. Proves both that the real bridge advertises
# ACP `agentCapabilities.loadSession` AND that this repo's own resume code
# correctly drives it after a genuine SIGKILL of the original child. Never
# run this proof on the host: it installs pi-acp (npm, on demand) and the
# [acp] extra, mutating the environment.
#
# Build:
#   docker build -f tests/docker/Dockerfile.pi-acp-resume-e2e -t audiagentic-pi-acp-resume-e2e:local .
# Run:
#   docker run --rm audiagentic-pi-acp-resume-e2e:local
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests

CMD ["bash", "-c", "uv venv /venv && uv pip install --python /venv/bin/python -q --no-compile -e '.[acp,mcp,test]' && /venv/bin/pytest tests/integration/providers/test_pi_acp_resume_live.py -q --tb=short --timeout=900"]
