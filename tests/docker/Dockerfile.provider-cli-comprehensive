FROM audia-test-base:latest

WORKDIR /app
ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_REAL_PROVIDER_CLI_TESTS=1
ENV PYTHONPATH="/app/src"
ENV PATH="/venv/bin:$PATH"
ENV HOME=/tmp/audiagentic-test-home
ENV AUDIAGENTIC_HOME=/tmp/audiagentic-test-home/.audiagentic

COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
COPY docs/examples ./docs/examples

RUN uv venv /venv && \
    uv pip install --python /venv/bin/python -q --no-compile -e '.[test]'

# Keep registry/recipe assertions and real install/uninstall workflows in the
# same image layer. The isolated provider runner supplies one fresh container
# per provider, so installed state never leaks between providers.
CMD ["/venv/bin/pytest", "tests/integration/providers/test_provider_cli_comprehensive.py", "tests/integration/providers/test_provider_cli_workflow_docker.py", "-v", "-x"]
