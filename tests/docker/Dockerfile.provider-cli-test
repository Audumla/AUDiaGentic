FROM audia-test-base:latest

WORKDIR /app
ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_REAL_PROVIDER_CLI_TESTS=1

COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
COPY docs/examples ./docs/examples

RUN python3 -m pip install --no-cache-dir --break-system-packages -e ".[test]"

CMD ["pytest", "tests/integration/providers/test_cli_provisioning_real.py", "-q"]
