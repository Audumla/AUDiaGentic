# Unified CLEAN suite image — runs the whole NON-mutating suite in one Linux
# container.
#
# Deliberately a clean toolchain: NO language servers or provider CLIs are baked
# in. It runs the non-mutating, hermetic unit, integration, and CLI tests in
# one controlled pass. Tests that need the *host* Docker daemon do not become
# hermetic merely by being invoked from a container, so the runner excludes
# their marker explicitly.
#
# What does NOT run here, and why:
#   - mutates_host tests (test_install_deps, provider lifecycle/CLI, provider-lsp)
#     exercise real MCP install RECIPES and assert install/uninstall from a clean
#     toolchain. They MUST stay in their own isolated images / fresh containers
#     so server state never leaks between tests and baked binaries never make an
#     install assertion trivially pass. run_suite.sh selects `not mutates_host`.
#   - mcp-tools-e2e CONSUMES pre-baked servers — its own image.
#
# Build: docker build -f tests/docker/Dockerfile.test -t audiagentic-test .
# Run:   docker run --rm audiagentic-test
FROM audia-test-base:latest

WORKDIR /app
ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_REPO_ROOT=/app

COPY pyproject.toml README.md release-please-config.json ./
COPY .gitignore ./
COPY src ./src
COPY tests ./tests
COPY docs/examples ./docs/examples
COPY docs/reference ./docs/reference
COPY docs/planning ./docs/planning
COPY .audiagentic/config ./.audiagentic/config
COPY .audiagentic/skills ./.audiagentic/skills
COPY .gemini ./.gemini
COPY .clinerules ./.clinerules
COPY .github/workflows ./.github/workflows
COPY .github/prompts ./.github/prompts
COPY .opencode ./.opencode
COPY AGENTS.md CLAUDE.md GEMINI.md ./

# Runtime records are mutable user/process state and are excluded from the
# build context. Tests that need the conventional location receive a clean
# empty root instead.
RUN mkdir -p .audiagentic/runtime

# Use uv (available in base image) to avoid pip bytecache corruption in Docker layers.
# Editable install keeps sources live for the test run; /venv/bin on PATH so
# run_suite.sh finds `pytest` without an explicit activate step.
ENV PATH="/venv/bin:$PATH"
RUN uv venv /venv && \
    uv pip install --python /venv/bin/python -q --no-compile \
        -e '.[mcp,acp]' pytest pytest-asyncio pytest-timeout pytest-xdist psutil 'websockets>=13' agent-client-protocol==0.11.0

# Whole non-mutating suite, parallel.
CMD ["bash", "tests/docker/run_suite.sh"]
