# MA18 Step 6 — Clean-room ACP transport validation in Docker.
#
# Proves that:
#   1. The [acp] extra installs cleanly from wheel
#   2. foundation/execution/acp.py imports without component/provider leakage
#   3. A protocol-level fixture (echo agent) runs end-to-end through run_acp_prompt
#   4. Host environment is untouched
#
# Build: docker build -f tests/docker/Dockerfile.acp-e2e -t audia-acp-e2e .
# Run:   docker run --rm audia-acp-e2e

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HOME=/tmp/audiagentic-docker

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
# Build wheel from source
RUN python3 -m pip install --no-cache-dir build && \
    python3 -m build --wheel --outdir /dist
# Install wheel then [acp] extra separately (pip doesn't handle extras in globs)
RUN python3 -m pip install --no-cache-dir /dist/*.whl
RUN python3 -m pip install --no-cache-dir audiagentic[acp] pytest pytest-asyncio pytest-timeout

WORKDIR /app
COPY tests ./tests
COPY .audiagentic/config ./.audiagentic/config

# Run the Docker-specific test that requires [acp] installed
CMD ["python3", "-m", "pytest", \
     "/app/tests/docker/test_acp_docker_gate.py", \
     "-v", "--tb=short", "--timeout=60"]
