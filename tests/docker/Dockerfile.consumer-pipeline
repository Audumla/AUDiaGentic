# Consumer Pipeline (AS19/AS30/AS31) Docker integration test image.
#
# Runs the full AS19 status observer, AS30 session binding, and AS31 output
# relay tests inside a clean Linux container with real process isolation.
# Validates end-to-end consumer pipeline behavior:
#   - AS19: observer ingress creates bindings, delivers observations,
#           invalidates on session close
#   - AS30: session bindings persist to disk, cross-process duplicate
#           detection is atomic, rebuild recovers from corruption
#   - AS31: output events persist atomically, fragment bounds enforced,
#           sequence monotonicity validated, relay failure degrades gracefully
#   - Full pipeline: AS19 + AS30 + AS31 together end-to-end
#
# Build:
#   docker build -f tests/docker/Dockerfile.consumer-pipeline \
#     -t audiagentic-consumer-pipeline:local .
# Run:
#   docker run --rm audiagentic-consumer-pipeline:local

FROM audia-test-base:latest

WORKDIR /app
ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV PYTHONPATH="/app/src"

COPY . /app

# Install the package (editable so source stays live) and test deps.
CMD ["/bin/bash", "-c", \
  "uv venv /venv && \
   uv pip install --python /venv/bin/python -q --no-compile -e '.[mcp,test]' && \
   /venv/bin/pytest tests/docker/test_consumer_pipeline_docker.py -v --tb=short --timeout=60"]
