# Copy to: tests/docker/provider-lifecycle.env
# Then fill only providers you want real prompt-launch coverage for.
# Missing values cause skips, not failures.

# Shared optional overrides
# AUDIAGENTIC_TEST_PROVIDER_PROMPT=Reply with exactly: OK
# AUDIAGENTIC_TEST_PROVIDER_EXPECTED=OK

# Pi
# AUDIAGENTIC_TEST_PI_MODEL=audiagentic-rig
# AUDIAGENTIC_TEST_PI_PROVIDER=audiagentic

# Claude
# ANTHROPIC_API_KEY=
# AUDIAGENTIC_TEST_CLAUDE_MODEL=sonnet

# Cline
# AUDIAGENTIC_TEST_CLINE_AUTH=1
# AUDIAGENTIC_TEST_CLINE_MODEL=cline-model

# Codex
# OPENAI_API_KEY=
# AUDIAGENTIC_TEST_CODEX_MODEL=gpt-5.4-mini

# Copilot
# GH_TOKEN=
# AUDIAGENTIC_TEST_COPILOT_MODEL=copilot-model

# Gemini
# GEMINI_API_KEY=
# AUDIAGENTIC_TEST_GEMINI_MODEL=gemini-1.5

# Local OpenAI
# AUDIAGENTIC_TEST_LOCAL_OPENAI_MODEL=gpt-oss
# AUDIAGENTIC_TEST_LOCAL_OPENAI_BASE_URL=http://host.docker.internal:11434

# OpenCode
# OPENAI_API_KEY=
# AUDIAGENTIC_TEST_OPENCODE_MODEL=openai/gpt-5.4-mini

# Qwen
# DASHSCOPE_API_KEY=
# AUDIAGENTIC_TEST_QWEN_MODEL=qwen-coder
