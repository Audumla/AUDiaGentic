FROM node:22-bookworm-slim

# Clear node:22 default CMD so derived images don't accidentally run `node`
ENTRYPOINT []
CMD ["bash"]

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/root/.local/bin:/venv/bin:${PATH}"

# Python + system deps (node already installed)
# build-essential supports Python packages with native extensions. Language
# compiler toolchains belong to the recipes that exercise them.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv python3-dev \
        git ca-certificates curl gpg gnupg wget libgomp1 bash procps \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/pip3 /usr/local/bin/pip \
    && ln -sf /usr/bin/python3 /usr/local/bin/python

# Common bootstrapper only; recipes install their own declared dependencies.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Provider CLIs, editors, language servers, Rust, Go, and even pytest are
# deliberately absent. This keeps lifecycle recipes honest: AUDiaGentic must
# install product dependencies, while each recipe declares test-only tooling.
RUN uv --version && node --version && python3 --version && git --version

# Set PYTHONPYCACHEPREFIX AFTER all build steps so build-time .pyc files
# are NOT written here (they'd be stale bytecode baked into the image).
# At runtime this redirects .pyc away from bind-mounted source, preventing
# cross-platform bytecode mismatches (Windows vs Linux Python).
ENV PYTHONPYCACHEPREFIX=/tmp/pycache
