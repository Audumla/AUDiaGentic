FROM audia-test-base:latest

WORKDIR /app
ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_REAL_PROVIDER_CLI_TESTS=1
ENV PYTHONPATH="/app/src"
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV HOME=/tmp/audiagentic-test-home
ENV AUDIAGENTIC_HOME=/tmp/audiagentic-test-home/.audiagentic

# Source is baked in (COPY), not bind-mounted: a -v $PWD:/app mount of the host
# filesystem deadlocks on Windows Docker Desktop. .dockerignore curates the context.
# Build: docker build -f tests/docker/Dockerfile.provider-config-matrix-e2e -t audiagentic-provider-config-matrix-e2e .
# Run:   docker run --rm audiagentic-provider-config-matrix-e2e
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
CMD ["bash", "-c", "export PATH=/root/.local/bin:$PATH && uv venv /venv && uv pip install --python /venv/bin/python -q --no-compile -e '.[mcp]' pytest pytest-timeout pytest-xdist pytest-asyncio tomli-w && /venv/bin/pytest tests/integration/providers/test_managed_config_capability_matrix_e2e.py -v --tb=short --timeout=600"]
