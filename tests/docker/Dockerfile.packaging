# Clean-room packaging validation — merges the former install-test, release-test
# and server-smoke images into one.
#
# These checks deliberately run WITHOUT the dev toolchain image: they prove the
# built wheel is self-contained (all YAML descriptors / configs / templates
# bundled) and that `audiagentic install` + the MCP servers work from a clean
# install. node is present because the agent install materializes node packages.
#
# Build: docker build -f tests/docker/Dockerfile.packaging -t audia-packaging .
# Run:   docker run --rm audia-packaging
FROM node:22-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV AUDIAGENTIC_STARTUP_STATUS=0
ENV AUDIAGENTIC_AUTO_UPDATE_ENABLED=false
ENV AUDIAGENTIC_DOCKER_TESTS=1
# Packaging smoke must never discover or mutate the container image's default
# root home.  Keeping every launcher-owned path below /tmp also makes the
# containment assertion in run_packaging.sh meaningful.
ENV HOME=/tmp/audiagentic-home
ENV AUDIAGENTIC_HOME=/tmp/audiagentic-home/.audiagentic
ENV XDG_CONFIG_HOME=/tmp/audiagentic-home/.config
ENV XDG_CACHE_HOME=/tmp/audiagentic-home/.cache

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv python3-dev \
        git ca-certificates \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Build the wheel from source, then install it cleanly (no editable install) so
# the validation exercises exactly what ships.
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
# build without --no-isolation so it manages its own setuptools version.
# python3 -m pip ensures the correct Python's pip is used (not a shell alias).
RUN python3 -m pip install --no-cache-dir --break-system-packages build && \
    python3 -m build --wheel --outdir /dist
RUN python3 -m pip install --no-cache-dir --no-compile --break-system-packages /dist/*.whl "mcp==1.27.0" pytest pytest-asyncio pytest-timeout

WORKDIR /app
COPY pyproject.toml ./pyproject.toml
# Static template root + tests + smoke script used by the three checks.
COPY .audiagentic/config ./.audiagentic/config
COPY .audiagentic/skills ./.audiagentic/skills
COPY .claude ./.claude
COPY .gemini ./.gemini
COPY .github/workflows ./.github/workflows
COPY .opencode ./.opencode
COPY AGENTS.md CLAUDE.md GEMINI.md ./
COPY tests ./tests

# Default cwd is disposable: any command omitting --project must still remain
# inside container runtime roots, never the packaged test checkout.
WORKDIR /tmp/audiagentic-packaging-project
CMD ["bash", "/app/tests/docker/run_packaging.sh"]
