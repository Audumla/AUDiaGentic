FROM audia-test-base:latest

ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_REAL_PROVIDER_CLI_TESTS=1
ENV AUDIAGENTIC_REPO_ROOT=/app
ENV HOME=/tmp/audiagentic-test-home
ENV AUDIAGENTIC_HOME=/tmp/audiagentic-test-home/.audiagentic
ENV PATH="/root/.cargo/bin:/usr/local/go/bin:${PATH}"

WORKDIR /app

# Compiler prerequisites only; AUDiaGentic installs the language servers.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal \
    && curl -fsSL https://go.dev/dl/go1.23.4.linux-amd64.tar.gz | tar -C /usr/local -xzf -

# Source is baked in (COPY), not bind-mounted: a -v $PWD:/app mount of the host
# filesystem deadlocks on Windows Docker Desktop. .dockerignore curates the context.
# Build: docker build -f tests/docker/Dockerfile.lsp-install-test -t audiagentic-lsp-install-test .
# Run:   docker run --rm audiagentic-lsp-install-test
#
# Use uv to create an isolated venv and install the project, bypassing system pip entirely.
# Debian Bookworm's Python 3.11 has a CPython ABI bug that causes system pip to fail with
# "SystemError: attempting to create PyCFunction with class but no METH_METHOD flag" during
# wheel resolution. uv's own installer does not invoke pip's C-extension path.
#
# The venv is created fresh each run inside the container (ephemeral).
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
CMD ["bash", "-c", "uv venv /venv && uv pip install --python /venv/bin/python -q --no-compile -e '.[mcp]' pytest pytest-asyncio pytest-timeout pytest-xdist && /venv/bin/pytest tests/integration/coding_lsp/test_install_deps.py tests/integration/coding_lsp/test_auto_install_e2e.py -v --tb=short"]
