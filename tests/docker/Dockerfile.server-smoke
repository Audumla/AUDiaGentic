# Slim isolated image for MCP server smoke testing.
# No rust/gh/vscode toolchains — only needs the package importable + mcp.
FROM python:3.13-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    AUDIAGENTIC_REPO_ROOT=/app PYTHONPYCACHEPREFIX=/tmp/pycache

COPY pyproject.toml README.md ./
COPY src ./src
COPY .audiagentic/config ./.audiagentic/config
COPY tests/docker/_server_smoke.py /server_smoke.py

RUN pip install --no-cache-dir --no-compile "setuptools>=67" wheel build \
    && python -m build --wheel --no-isolation --outdir /dist \
    && pip install --no-cache-dir --no-compile /dist/*.whl "mcp==1.27.0"

CMD ["python", "/server_smoke.py"]
