FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --no-cache-dir -e '.[test]'

COPY tests ./tests

# This is deliberately a credential-free materialization gate.  Networked Pi
# package installation belongs to its separately opt-in provider image.
CMD ["python", "-m", "pytest", "tests/integration/harness/test_harness_user_path.py", "-q"]
