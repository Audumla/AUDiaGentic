FROM audia-test-base:latest

WORKDIR /app
ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_PI_RPC_TAP_E2E_DOCKER=1
ENV HOME=/tmp/audiagentic-test-home
ENV AUDIAGENTIC_HOME=/tmp/audiagentic-test-home/.audiagentic
ENV PYTHONPATH="/app/src"
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# AS40 validate-first: exact-version RPC transcript fixture, tapped. Real
# npm-installed Pi CLI + real embedded llama-server rig + real local GGUF
# model (no external API keys), driving a real ACP session/new + session/prompt
# through pi-acp with the tee shim installed at PI_ACP_PI_COMMAND, proving the
# tap survives a genuine multi-message conversational turn (agent_start ->
# message updates -> agent_end), not just the handshake covered by
# tests/integration/providers/test_pi_rpc_tap_real_binaries.py. Reuses the
# same provisioning as Dockerfile.gateway-pi-smoke.
#
# Build:
#   docker build -f tests/docker/Dockerfile.pi-rpc-tap-e2e -t audiagentic-pi-rpc-tap-e2e:local .
# Run:
#   docker run --rm audiagentic-pi-rpc-tap-e2e:local
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests

CMD ["bash", "-c", "uv venv /venv && uv pip install --python /venv/bin/python -q --no-compile -e '.[mcp,test]' && /venv/bin/pytest tests/integration/providers/test_pi_rpc_tap_transcript_e2e.py -q --tb=short --timeout=900"]
