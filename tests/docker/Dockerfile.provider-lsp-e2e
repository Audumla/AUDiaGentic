FROM audia-test-base:latest

ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_REAL_PROVIDER_CLI_TESTS=1
ENV AUDIAGENTIC_REPO_ROOT=/app
ENV HOME=/tmp/audiagentic-test-home
ENV AUDIAGENTIC_HOME=/tmp/audiagentic-test-home/.audiagentic
ENV PATH="/root/.cargo/bin:/usr/local/go/bin:${PATH}"
# Opt in to also exercise rust + cpp servers (slow: cargo build / apt clangd):
#   docker run -e AUDIAGENTIC_LSP_E2E_ALL=1 ...

WORKDIR /app

# Toolchains for the default language servers:
#   - uv installs pyright (Python)
#   - npm installs typescript-language-server (TypeScript) and the provider CLIs
#   - clangd via apt (only used when AUDIAGENTIC_LSP_E2E_ALL=1)
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg clangd \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal \
    && curl -fsSL https://go.dev/dl/go1.23.4.linux-amd64.tar.gz | tar -C /usr/local -xzf -

# Source is baked in (COPY), not bind-mounted: a -v $PWD:/app mount of the host
# filesystem deadlocks on Windows Docker Desktop. .dockerignore curates the context.
# Build: docker build -f tests/docker/Dockerfile.provider-lsp-e2e -t audiagentic-provider-lsp-e2e .
# Run:   docker run --rm audiagentic-provider-lsp-e2e
#
# The project is installed into an isolated uv venv (see Dockerfile.lsp-install-test
# for why system pip is avoided on this base image). The language-server binaries
# themselves and the native-LSP provider CLIs are installed by the test's
# provisioning fixture via the real scoped workflows, so the test exercises
# actual installation, not a pre-baked environment.
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
CMD ["bash", "-c", "uv venv /venv && uv pip install --python /venv/bin/python -q --no-compile -e '.[mcp]' pytest pytest-timeout pytest-xdist pytest-asyncio && /venv/bin/pytest tests/integration/coding_lsp/test_provider_lsp_e2e.py -v --tb=short --timeout=300"]
