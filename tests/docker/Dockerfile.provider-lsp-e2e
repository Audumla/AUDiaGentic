FROM audia-test-base:latest

ENV AUDIAGENTIC_DOCKER_TESTS=1
ENV AUDIAGENTIC_REPO_ROOT=/app
# Opt in to also exercise rust + cpp servers (slow: cargo build / apt clangd):
#   docker run -e AUDIAGENTIC_LSP_E2E_ALL=1 ...

WORKDIR /app

# Toolchains for the default language servers:
#   - uv installs pyright (Python)
#   - npm installs typescript-language-server (TypeScript) and the provider CLIs
#   - clangd via apt (only used when AUDIAGENTIC_LSP_E2E_ALL=1)
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg clangd \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Source mounted at runtime — no COPY here.
# Build: docker build -f tests/docker/Dockerfile.provider-lsp-e2e -t audiagentic-provider-lsp-e2e .
# Run:   docker run --rm -v $PWD:/app audiagentic-provider-lsp-e2e
#
# The project is installed into an isolated uv venv (see Dockerfile.lsp-install-test
# for why system pip is avoided on this base image). The language-server binaries
# themselves and the native-LSP provider CLIs are installed by the test's
# provisioning fixture via the real scoped workflows, so the test exercises
# actual installation, not a pre-baked environment.
CMD ["bash", "-c", "uv venv /venv && uv pip install --python /venv/bin/python -q --no-compile -e '.[mcp]' pytest pytest-timeout pytest-asyncio && /venv/bin/pytest tests/integration/coding_lsp/test_provider_lsp_e2e.py -v --tb=short"]
