{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ]
    },
    "github": {
      "command": "gh",
      "args": [
        "mcp",
        "serve"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "ag-ledger": {
      "command": "C:/example-home/AppData/Local/Microsoft/WindowsApps/PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0/python.exe",
      "args": [
        "-m",
        "audiagentic.components.optional.ledger.ledger_mcp"
      ],
      "env": {
        "PYTHONPATH": "C:/example-dev-root/audiagentic/src"
      }
    },
    "ag-lsp": {
      "command": "C:/example-home/AppData/Local/Microsoft/WindowsApps/PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0/python.exe",
      "args": [
        "-m",
        "audiagentic.components.optional.coding_lsp.lsp_mcp"
      ],
      "env": {
        "PYTHONPATH": "C:/example-dev-root/audiagentic/src"
      }
    }
  }
}