{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp==1.27.0",
        "mcp-server-git",
        "--repository",
        "."
      ]
    },
    "github": {
      "command": "gh",
      "args": [
        "mcp",
        "serve"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "ag-ledger": {
      "command": "C:\\Users\\mgs\\AppData\\Local\\Microsoft\\WindowsApps\\PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0\\python.exe",
      "args": [
        "-m",
        "audiagentic.launcher",
        "mcp",
        "audiagentic.components.ledger.ledger_mcp"
      ],
      "env": {
        "AUDIAGENTIC_REPO_ROOT": "H:\\development\\projects\\AUDia\\AUDiaGentic"
      }
    },
    "ag-agents-gateway": {
      "command": "C:\\Users\\mgs\\AppData\\Local\\Microsoft\\WindowsApps\\PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0\\python.exe",
      "args": [
        "-m",
        "audiagentic.launcher",
        "mcp",
        "audiagentic.components.agents.mcp.gateway_mcp"
      ],
      "env": {
        "AUDIAGENTIC_REPO_ROOT": "H:\\development\\projects\\AUDia\\AUDiaGentic"
      }
    },
    "ag-lsp": {
      "command": "C:\\Users\\mgs\\AppData\\Local\\Microsoft\\WindowsApps\\PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0\\python.exe",
      "args": [
        "-m",
        "audiagentic.launcher",
        "mcp",
        "audiagentic.components.coding_lsp.lsp_mcp"
      ],
      "env": {
        "AUDIAGENTIC_REPO_ROOT": "H:\\development\\projects\\AUDia\\AUDiaGentic"
      }
    },
    "ag-planning": {
      "command": "C:\\Users\\mgs\\AppData\\Local\\Microsoft\\WindowsApps\\PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0\\python.exe",
      "args": [
        "-m",
        "audiagentic.launcher",
        "mcp",
        "audiagentic.components.planning.planning_mcp"
      ],
      "env": {
        "AUDIAGENTIC_REPO_ROOT": "H:\\development\\projects\\AUDia\\AUDiaGentic"
      }
    }
  }
}