{
  "_comment": "MANAGED_BY_AUDIAGENTIC: do not edit directly.",
  "_description": "Gemini configuration for AUDiaGentic prompt-trigger integration",
  "_hook_status": "fallback-only",
  "_hook_notes": "Gemini CLI does not expose a native BeforeAgent hook in the current version. The repository uses the fallback bridge path exclusively for prompt-trigger launches.",
  "bridge": {
    "path": "tools/gemini_prompt_trigger_bridge.py",
    "args": [
      "--project-root",
      "."
    ]
  },
  "fallback_path": {
    "enabled": true,
    "description": "Use the bridge for all prompt-trigger launches since native hook is unavailable"
  },
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ]
    },
    "github": {
      "command": "gh",
      "args": [
        "mcp",
        "serve"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "ag-ledger": {
      "command": "C:/Users/mgs/AppData/Local/Microsoft/WindowsApps/PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0/python.exe",
      "args": [
        "-m",
        "audiagentic.components.optional.ledger.ledger_mcp"
      ],
      "env": {
        "PYTHONPATH": "H:/development/projects/AUDia/AUDiaGentic/src"
      }
    },
    "ag-lsp": {
      "command": "C:/Users/mgs/AppData/Local/Microsoft/WindowsApps/PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0/python.exe",
      "args": [
        "-m",
        "audiagentic.components.optional.coding_lsp.lsp_mcp"
      ],
      "env": {
        "PYTHONPATH": "H:/development/projects/AUDia/AUDiaGentic/src"
      }
    }
  }
}