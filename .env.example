# =============================================================================
# AUDiaGentic — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the keys you need.
# .env is gitignored — this template is tracked as documentation.
#
# Secrets can also be set via:
#   - Shell environment (export KEY=value)
#   - .audiagentic/secrets/test.env (loaded automatically by test conftest)
#   - .audiagentic/secrets/prod.env (loaded when AUDIAGENTIC_ENV=prod)
#
# See docs/standards/SECRETS_MANAGEMENT.md for full documentation.

# --- Vendor API Keys ---
# Required for real provider prompt-launch tests.
# Missing values cause test skips, not failures.

# OpenAI (pi, qwen, codex, opencode)
# OPENAI_API_KEY=

# Anthropic (pi, qwen, claude)
# ANTHROPIC_API_KEY=

# Google (pi, qwen, gemini)
# GEMINI_API_KEY=

# OpenRouter (pi)
# OPENROUTER_API_KEY=

# DashScope (qwen)
# DASHSCOPE_API_KEY=

# --- GitHub ---
# Optional. Used for release workflows and repository operations.
# AUDIAGENTIC_GITHUB_TOKEN=     # highest priority
# GITHUB_TOKEN=                 # fallback
# GH_TOKEN=                     # fallback

# --- Internal ---
# Rarely needed in development. Listed for completeness.
# AUDIAGENTIC_HOME=             # override ~/.audiagentic
# AUDIAGENTIC_ENV=              # select secrets file (default: test)
# AUDIAGENTIC_GITHUB_CLIENT_ID= # override OAuth client ID
